// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  walletAddress String    @unique
  role          Role      @default(USER)
  profile       Profile?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  stakedNFTs    StakedNFT[]
  bookings      Booking[]
  mintJobs      MintJob[]
}

model Profile {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  username  String?
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Shuttle {
  id               String      @id @default(uuid())
  name             String
  capacity         Int
  isFractionalized Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  bookings         Booking[]
  stakedNFTs       StakedNFT[]
  event            Event?      @relation(fields: [eventId], references: [id])
  eventId          String?
}

model Event {
  id        String    @id @default(uuid())
  name      String
  date      DateTime
  location  String
  shuttles  Shuttle[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Booking {
  id             String         @id @default(uuid())
  user           User           @relation(fields: [userId], references: [id])
  userId         String
  shuttle        Shuttle        @relation(fields: [shuttleId], references: [id])
  shuttleId      String
  totalPriceUsdc Decimal
  paymentStatus  PaymentStatus  @default(PENDING)
  reference      String?        @unique // For Solana Pay
  signature      String?        @unique // For Solana Pay
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model StakedNFT {
  id            String      @id @default(uuid())
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  walletAddress String
  tokenMint     String      @unique
  stakeType     StakeType
  tier          StakingTier
  shuttle       Shuttle?    @relation(fields: [shuttleId], references: [id])
  shuttleId     String?
  isActive      Boolean     @default(true)
  stakedAt      DateTime    @default(now())
  unstakedAt    DateTime?
  payouts       Payout[]
}

model Payout {
  id        String    @id @default(uuid())
  stakedNFT StakedNFT @relation(fields: [stakedNFTId], references: [id])
  stakedNFTId String
  amount    Decimal
  payoutDate DateTime @default(now())
}

model MintJob {
  id               String      @id @default(cuid())
  status           JobStatus   @default(PENDING)
  walletAddress    String
  user             User?       @relation(fields: [walletAddress], references: [walletAddress], onUpdate: NoAction, onDelete: NoAction)
  paymentSignature String      @unique
  mintAddress      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

enum Role { USER ADMIN }
enum PaymentStatus { PENDING COMPLETED FAILED }
enum StakeType { POOL FRACTIONAL }
enum StakingTier { TIER_1 TIER_2 }
enum JobStatus { PENDING PROCESSING COMPLETED FAILED }