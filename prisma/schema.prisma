generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(uuid())
  walletAddress   String?   @unique  // Optional for drivers/owners
  email           String?   @unique  // Required for drivers/owners
  password        String?             // For email/password auth
  phoneNumber     String?
  role            UserRole  @default(SEEKER)
  isNFTHolder     Boolean   @default(false)
  nftTokens       String[]
  fcmToken        String?   // Firebase Cloud Messaging token
  notificationSettings Json? @default("{\"rideUpdates\":true,\"promotions\":true,\"rewards\":true}") // User notification preferences
  locationSettings Json? @default("{\"shareLocation\":true,\"locationAccuracy\":\"high\"}") // Location sharing preferences
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  bookings        Booking[]
  rewards         Reward[]
  stakedNFTs      StakedNFT[]
  driverProfile   Driver?
  ownerProfile    Owner?
  
  @@index([walletAddress])
  @@index([email])
  @@index([isNFTHolder])
}

model Driver {
  id                String    @id @default(uuid())
  userId            String    @unique
  licenseNumber     String    @unique
  vehicleType       String
  rating            Decimal   @default(5.0) @db.Decimal(3, 2)
  totalRides        Int       @default(0)
  isOnline          Boolean   @default(false)
  isVerified        Boolean   @default(false)
  currentShuttleId  String?
  earnings          Decimal   @default(0) @db.Decimal(10, 2)
  ownerId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User      @relation(fields: [userId], references: [id])
  owner             Owner?    @relation(fields: [ownerId], references: [id])
  shuttles          Shuttle[]
  
  @@index([isOnline])
  @@index([isVerified])
  @@index([ownerId])
}

model Owner {
  id                String    @id @default(uuid())
  userId            String    @unique
  companyName       String
  licenseNumber     String    @unique
  isVerified        Boolean   @default(false)
  totalRevenue      Decimal   @default(0) @db.Decimal(10, 2)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  user              User      @relation(fields: [userId], references: [id])
  drivers           Driver[]
  vehicles          Vehicle[]
  
  @@index([isVerified])
}

model Vehicle {
  id                String    @id @default(uuid())
  ownerId           String
  vehicleNumber     String    @unique
  vehicleType       String
  capacity          Int
  licensePlate      String    @unique
  isActive          Boolean   @default(true)
  lastMaintenance   DateTime?
  nextMaintenance   DateTime?
  mileage           Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  owner             Owner     @relation(fields: [ownerId], references: [id])
  
  @@index([ownerId])
  @@index([isActive])
}

enum UserRole {
  SEEKER
  DRIVER
  OWNER
  ADMIN
}

model Event {
  id              String    @id @default(uuid())
  name            String
  description     String?
  location        Json      // {lat, lng, address}
  eventDate       DateTime
  eventType       String
  imageUrl        String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  shuttles        Shuttle[]
  
  @@index([eventDate])
  @@index([isActive])
}

model Shuttle {
  id                    String          @id @default(uuid())
  eventId               String
  vehicleNumber         String
  capacity              Int
  departureTime         DateTime
  arrivalTime           DateTime
  pickupLocation        Json
  dropoffLocation       Json
  basePrice             Decimal         @db.Decimal(10, 2)
  currency              String          @default("USDC")
  status                ShuttleStatus   @default(SCHEDULED)
  isFractionalized      Boolean         @default(false)
  currentLocation       Json?
  driverId              String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  
  event                 Event           @relation(fields: [eventId], references: [id])
  driver                Driver?         @relation(fields: [driverId], references: [id])
  bookings              Booking[]
  stakedNFTs            StakedNFT[]
  
  @@index([eventId])
  @@index([status])
  @@index([departureTime])
}

enum ShuttleStatus {
  SCHEDULED
  BOARDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

model Booking {
  id                String          @id @default(uuid())
  userId            String
  shuttleId         String
  bookingDate       DateTime        @default(now())
  numberOfSeats     Int             @default(1)
  totalPrice        Decimal         @db.Decimal(10, 2)
  paymentStatus     PaymentStatus   @default(PENDING)
  transactionHash   String?         @unique
  status            BookingStatus   @default(CONFIRMED)
  rating            Int?
  review            String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  
  user              User            @relation(fields: [userId], references: [id])
  shuttle           Shuttle         @relation(fields: [shuttleId], references: [id])
  reward            Reward?
  
  @@index([userId])
  @@index([shuttleId])
  @@index([paymentStatus])
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REFUNDED
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Reward {
  id                String    @id @default(uuid())
  userId            String
  bookingId         String    @unique
  xpPoints          Int
  co2XpPoints       Int
  isRedeemed        Boolean   @default(false)
  redeemedAmount    Decimal?  @db.Decimal(10, 2)
  redeemedAt        DateTime?
  createdAt         DateTime  @default(now())
  
  user              User      @relation(fields: [userId], references: [id])
  booking           Booking   @relation(fields: [bookingId], references: [id])
  
  @@index([userId])
  @@index([isRedeemed])
}

model StakedNFT {
  id                String        @id @default(uuid())
  userId            String
  nftMintAddress    String
  stakingTier       StakingTier
  shuttleId         String?       // For fractionalized ownership
  stakedAt          DateTime      @default(now())
  unstakedAt        DateTime?
  isActive          Boolean       @default(true)
  totalEarnings     Decimal       @default(0) @db.Decimal(10, 2)
  lastPayoutAt      DateTime?
  
  user              User          @relation(fields: [userId], references: [id])
  shuttle           Shuttle?      @relation(fields: [shuttleId], references: [id])
  payouts           Payout[]
  
  @@unique([nftMintAddress, isActive])
  @@index([userId])
  @@index([isActive])
}

enum StakingTier {
  TIER_1  // 1 NFT - 25% share
  TIER_2  // 3+ NFTs - 40% share
}

model Payout {
  id              String      @id @default(uuid())
  stakedNFTId     String
  amount          Decimal     @db.Decimal(10, 2)
  payoutType      PayoutType
  transactionHash String?
  status          PayoutStatus @default(PENDING)
  payoutDate      DateTime    @default(now())
  
  stakedNFT       StakedNFT   @relation(fields: [stakedNFTId], references: [id])
  
  @@index([stakedNFTId])
  @@index([status])
}

enum PayoutType {
  REVENUE_SHARE
  FRACTIONAL_OWNERSHIP
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
